{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sunflow/schema/profile.schema.json",
  "title": "Sunflow device profile",
  "description": "Maps a device of a Home Assistant integration to Sunflow roles and actions.",
  "type": "object",
  "required": ["profile", "version", "capabilities", "roles"],
  "oneOf": [
    {"description": "Device of a Home Assistant integration", "required": ["match"]},
    {"description": "Device Sunflow talks to itself", "required": ["connection"]}
  ],
  "additionalProperties": false,
  "properties": {
    "profile": {
      "description": "Profile id: <integration domain>/<variant>.",
      "type": "string",
      "pattern": "^[a-z0-9_]+/[a-z0-9_]+$"
    },
    "version": {"type": "integer", "minimum": 1},
    "match": {"$ref": "#/$defs/match"},
    "connection": {
      "description": "Sunflow talks to the device itself (no integration). Each point becomes an entity whose unique_id ends with its key, so roles name points by key as for integrations. The address (host, port, unit id) is entered when adding the device.",
      "type": "object",
      "required": ["type", "points"],
      "additionalProperties": false,
      "properties": {
        "type": {"enum": ["modbus_tcp", "http"]},
        "port": {"description": "Default port (502 for Modbus TCP, 80 for HTTP).", "type": "integer", "minimum": 1, "maximum": 65535},
        "unit_id": {"description": "Default Modbus unit id.", "type": "integer", "minimum": 0, "maximum": 255},
        "word_order": {"description": "Order of the 16-bit words of 32-bit values.", "enum": ["big", "little"], "default": "big"},
        "poll": {"$ref": "#/$defs/duration"},
        "manufacturer": {"type": "string"},
        "model": {"type": "string"},
        "points": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"$ref": "#/$defs/identifier"},
          "additionalProperties": {"$ref": "#/$defs/point"}
        }
      }
    },
    "name_strip": {
      "description": "Parts removed from the device name to build the display name.",
      "type": "array",
      "items": {"type": "string"}
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": ["pv", "pv_ext", "battery", "grid_meter", "battery_window", "curtail", "switch_off", "ev_charger", "load", "loadpoint"]
      }
    },
    "watchdog": {
      "description": "Device-side fallback when control stops: none, on communication loss, or on missing commands.",
      "enum": ["none", "comm_loss", "command"],
      "default": "none"
    },
    "fallback": {
      "description": "Action executed when Sunflow stops controlling the device.",
      "type": "string"
    },
    "roles": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"$ref": "#/$defs/identifier"},
      "additionalProperties": {"$ref": "#/$defs/role"}
    },
    "control_mode": {
      "description": "Select entity and option the device must be in for the primitive to take effect.",
      "type": "object",
      "required": ["key", "option"],
      "additionalProperties": false,
      "properties": {
        "key": {"type": "string"},
        "option": {"type": "string"}
      }
    },
    "primitive": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/identifier"},
      "additionalProperties": {"$ref": "#/$defs/primitive"}
    },
    "parameters": {
      "description": "Device characteristics configured in the setup wizard; also usable as variables in actions.",
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/identifier"},
      "additionalProperties": {"$ref": "#/$defs/parameter"}
    },
    "actions": {
      "description": "Named presets of the primitive's parameters. Values are numbers or names of parameters / runtime values, optionally negated.",
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/identifier"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "oneOf": [
            {"type": "number"},
            {"type": "string", "pattern": "^-?[A-Za-z_][A-Za-z0-9_]*$"}
          ]
        }
      }
    },
    "setup": {
      "description": "Steps executed once when the device is activated.",
      "type": "array",
      "items": {"$ref": "#/$defs/step"}
    },
    "battery_control": {
      "description": "Battery control by action, for devices without a power window: steps per action (auto, hold, force_charge, force_discharge, limit_charge, limit_discharge; runtime P in W). Actions left out are not supported; the plan avoids them or falls back to a related one. release: steps when Sunflow hands the battery back (default: auto). refresh: send the action again after this time although nothing changed (devices that fall back without new commands).",
      "type": "object",
      "required": ["auto"],
      "additionalProperties": false,
      "properties": {
        "auto": {"$ref": "#/$defs/steps"},
        "hold": {"$ref": "#/$defs/steps"},
        "force_charge": {"$ref": "#/$defs/steps"},
        "force_discharge": {"$ref": "#/$defs/steps"},
        "limit_charge": {"$ref": "#/$defs/steps"},
        "limit_discharge": {"$ref": "#/$defs/steps"},
        "release": {"$ref": "#/$defs/steps"},
        "refresh": {"$ref": "#/$defs/duration"},
        "full_power_only": {"description": "Forced charge or discharge always runs at the device's full power.", "type": "boolean"}
      }
    },
    "pv_limit": {
      "description": "Limiting the PV output: set (runtime limit_w in W) and release (no limit). refresh as for battery_control.",
      "type": "object",
      "required": ["set", "release"],
      "additionalProperties": false,
      "properties": {
        "set": {"$ref": "#/$defs/steps"},
        "release": {"$ref": "#/$defs/steps"},
        "refresh": {"$ref": "#/$defs/duration"}
      }
    },
    "charge_control": {
      "description": "Charging control of a loadpoint: steps for charge (runtime current_a), stop and release (back to the device's own logic). remember: a select whose option is stored on takeover and restored on hand back.",
      "type": "object",
      "required": ["charge", "stop"],
      "additionalProperties": false,
      "properties": {
        "charge": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/step"}},
        "stop": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/step"}},
        "release": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/step"}},
        "authorize": {
          "description": "Starts the charging transaction when a card is required (runtime transaction: option of the vehicle's card).",
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/step"}
        },
        "follow": {
          "description": "Used instead of charge when less than full power is planned and the device can follow the PV surplus itself.",
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/step"}
        },
        "remember": {
          "type": "object",
          "required": ["key"],
          "additionalProperties": false,
          "properties": {"key": {"type": "string"}}
        }
      }
    },
    "eeprom_guard": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_writes_per_day": {"type": "integer", "minimum": 1}
      }
    }
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "parameter": {
      "type": "object",
      "required": ["unit"],
      "additionalProperties": false,
      "properties": {
        "unit": {"type": "string"},
        "default": {"type": "number"},
        "min": {"type": "number"},
        "max": {"type": "number"},
        "advanced": {"type": "boolean"},
        "kind": {
          "description": "Only shown for devices of this kind (e.g. an evcc loadpoint with a vehicle or a heater).",
          "enum": ["vehicle", "heater"]
        },
        "derive": {
          "description": "Suggest a value from sensors: sum of all entities (device and sub-devices) with this key, times factor.",
          "type": "object",
          "required": ["sum_key"],
          "additionalProperties": false,
          "properties": {
            "sum_key": {"type": "string"},
            "factor": {"type": "number", "default": 1}
          }
        }
      }
    },
    "match": {
      "type": "object",
      "required": ["integration"],
      "additionalProperties": false,
      "properties": {
        "integration": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "requires": {
          "description": "Entity keys that must exist on the device.",
          "type": "array",
          "items": {"type": "string"}
        },
        "has_battery": {"type": "boolean"},
        "model": {
          "description": "Glob pattern(s) matched against the device model; any of a list may match (e.g. localized names).",
          "oneOf": [
            {"type": "string"},
            {"type": "array", "items": {"type": "string"}, "minItems": 1}
          ]
        },
        "manufacturer": {"type": "string"}
      }
    },
    "role": {
      "type": "object",
      "required": ["key"],
      "additionalProperties": false,
      "properties": {
        "key": {
          "description": "Entity key; matched against the end of the entity's unique_id.",
          "type": "string"
        },
        "unit": {"type": "string"},
        "sign": {"enum": ["charge_positive", "discharge_positive", "import_positive", "export_positive"]},
        "optional": {"type": "boolean", "default": false},
        "fine_keys": {
          "description": "Entities with a finer resolution (e.g. per battery input) whose sum replaces the live value when any is readable; the key's entity stays for statistics.",
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "storage": {
      "description": "Where the device persists a written value.",
      "enum": ["volatile", "eeprom"]
    },
    "primitive": {
      "type": "object",
      "required": ["params", "steps"],
      "additionalProperties": false,
      "properties": {
        "params": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/identifier"},
          "additionalProperties": {"type": "string"}
        },
        "storage": {"$ref": "#/$defs/storage"},
        "refresh": {"$ref": "#/$defs/duration"},
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/step"}
        }
      }
    },
    "point": {
      "description": "A value read from the device: a Modbus register (address, encoding) or a JSON value of an HTTP GET (path, json).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "address": {"type": "integer", "minimum": 0, "maximum": 65535},
        "type": {"enum": ["holding", "input"], "default": "holding"},
        "encoding": {"$ref": "#/$defs/encoding"},
        "path": {"type": "string", "pattern": "^/"},
        "json": {"description": "Dotted path into the response; list items by index.", "type": "string"},
        "scale": {"type": "number"},
        "unit": {"type": "string"},
        "device_class": {"type": "string"}
      },
      "oneOf": [{"required": ["address", "encoding"]}, {"required": ["path"]}]
    },
    "encoding": {"enum": ["int16", "uint16", "int32", "uint32"]},
    "duration": {"type": "string", "pattern": "^[0-9]+(s|min|h)$"},
    "steps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/step"}},
    "step_options": {
      "type": "object",
      "properties": {
        "key": {"type": "string"},
        "role": {"description": "Entity of this role instead of a key (devices whose entities the user chose).", "type": "string"},
        "optional": {"description": "With role: leave the step out when the role is not bound.", "type": "boolean"},
        "storage": {"$ref": "#/$defs/storage"},
        "write": {"enum": ["always", "if_differs"]},
        "readback": {"type": "string"}
      }
    },
    "step": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "number": {
          "allOf": [
            {"$ref": "#/$defs/step_options"},
            {
              "required": ["value"],
              "properties": {
                "value": {"type": ["number", "string"]},
                "min": {"type": "number"},
                "max": {"type": "number"},
                "tolerance": {"description": "Current values this close count as set; spares writes to flash.", "type": "number", "minimum": 0}
              }
            }
          ]
        },
        "select": {
          "allOf": [
            {"$ref": "#/$defs/step_options"},
            {"required": ["option"], "properties": {"option": {"type": "string"}}}
          ]
        },
        "switch": {
          "allOf": [
            {"$ref": "#/$defs/step_options"},
            {"required": ["state"], "properties": {"state": {"enum": ["on", "off"]}}}
          ]
        },
        "press": {
          "allOf": [
            {"$ref": "#/$defs/step_options"},
            {"required": ["key"]}
          ]
        },
        "modbus": {
          "description": "Write a holding register of a directly connected device; value / scale is written.",
          "type": "object",
          "required": ["address", "value"],
          "additionalProperties": false,
          "properties": {
            "address": {"type": "integer", "minimum": 0, "maximum": 65535},
            "encoding": {"$ref": "#/$defs/encoding"},
            "scale": {"type": "number"},
            "value": {"type": ["number", "string"]},
            "min": {"type": "number"},
            "max": {"type": "number"},
            "tolerance": {"type": "number", "minimum": 0},
            "storage": {"$ref": "#/$defs/storage"},
            "write": {"enum": ["always", "if_differs"]}
          }
        },
        "http": {
          "description": "Send a request to a directly connected device; strings in body are templated.",
          "type": "object",
          "required": ["path"],
          "additionalProperties": false,
          "properties": {
            "method": {"enum": ["POST", "PUT", "PATCH", "GET"], "default": "POST"},
            "path": {"type": "string", "pattern": "^/"},
            "body": {},
            "storage": {"$ref": "#/$defs/storage"},
            "write": {"enum": ["always", "if_differs"]}
          }
        },
        "service": {
          "type": "object",
          "required": ["action"],
          "properties": {
            "action": {"type": "string", "pattern": "^[a-z0-9_]+\\.[a-z0-9_]+$"},
            "data": {"type": "object"},
            "storage": {"$ref": "#/$defs/storage"}
          }
        }
      },
      "additionalProperties": false
    }
  }
}
